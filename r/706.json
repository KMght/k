{
  "title": "下級裁判所裁判官指名諮問委員会規則",
  "law_number": "平成15年2月26日最高裁判所規則第6号",
  "enforcement_date": "平成15年5月1日",
  "enforcement_iso": "2003-05-01",
  "pdf_link": "https://www.courts.go.jp/assets/kakyuusaibansyosaibankansimeisimoniinkai.pdf",
