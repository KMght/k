{
  "title": "執行官規則",
  "law_number": "昭和41年11月8日最高裁判所規則第10号",
  "enforcement_date": "平成19年4月1日",
  "enforcement_iso": "2007-04-01",
  "pdf_link": "https://www.courts.go.jp/vc-files/courts/2022/sikkoukankisoku.pdf",
