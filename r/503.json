      "note": "",
      "paragraphs": [
        {
          "number": 1,
          "text": "この規則は、法の施行の日（平成二十年十二月一日）から施行する。",
          "items": []
        }
      ],
      "type": "article"
    },
    {
      "type": "division",
      "kind": "附則",
      "label": "附則",
      "title": "（平成二四年七月一七日最高裁判所規則第九号）抄",
      "anchor": "sup2",
      "level": 1,
      "page": 6,
      "note": ""
    },
    {
      "number": [
        1
      ],
      "label": "第一条",
      "short_label": "1条",
      "anchor": "sup2-a1",
      "caption": "施行期日",
      "deleted": false,
      "section": "supplementary",
      "page": 6,
      "division_path": [],
      "sup_index": 2,
      "label_override": null,
      "alias_numbers": [],
      "note": "",
      "paragraphs": [
        {
          "number": 1,
          "text": "この規則は、非訟事件手続法（平成二十三年法律第五十一号）の施行の日から施行する。",
          "items": []
