      "deleted": false,
      "section": "supplementary",
      "page": 1,
      "division_path": [],
      "sup_index": 1,
      "label_override": null,
      "alias_numbers": [],
      "note": "",
      "paragraphs": [
        {
          "number": 1,
          "text": "この規則は、平成十五年八月一日から施行する。",
          "items": []
        }
      ],
      "type": "article"
    }
  ]
}