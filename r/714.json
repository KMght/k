{
  "title": "法廷等の秩序維持に関する規則",
  "law_number": "昭和27年9月1日最高裁判所規則第20号",
  "enforcement_date": "平成18年5月24日",
  "enforcement_iso": "2006-05-24",
  "pdf_link": "https://www.courts.go.jp/assets/R6.9.17houteitounotitujoijinikannsurukisoku.pdf",
