      "label_override": null,
      "alias_numbers": [],
      "note": "",
      "paragraphs": [
        {
          "number": 1,
          "text": "この規則は、平成十六年一月一日から施行する。",
          "items": []
        }
      ],
      "type": "article"
    },
    {
