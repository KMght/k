          "items": []
        }
      ],
      "type": "article"
    },
    {
      "number": [
        3
      ],
      "label": "第三条",
      "short_label": "3条",
      "anchor": "sup3-a3",
      "caption": "裁判官の分限事件手続規則の一部改正に伴う経過措置",
      "deleted": false,
      "section": "supplementary",
      "page": 2,
      "division_path": [],
      "sup_index": 3,
      "label_override": null,
      "alias_numbers": [],
      "note": "",
      "paragraphs": [
        {
          "number": 1,
          "text": "この規則の施行前に申し立てられた分限事件の手続については、なお従前の例による。",
          "items": []
        }
      ],
